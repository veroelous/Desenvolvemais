HOST=127.0.0.1
PORT=3000
DATA_DIR=./dados
ADMIN_USER=admin
ADMIN_PASSWORD=
NOTIFY_TO=contato@manoelgoncalves.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Número do Manoel para o convite "Conversar pelo WhatsApp" após o envio (com DDI). Vazio = convite oculto.
CONTACT_WHATSAPP=
# Origem HTTPS exata em implantação externa (também gera o link do resultado no e-mail de aviso).
PUBLIC_ORIGIN=
# Limite de envios por IP (padrão 10 a cada 10 minutos). TRUST_PROXY=1 só atrás de proxy confiável.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=600000
TRUST_PROXY=
